# 复制为 .env 后填写真实值。.env 已被 git 忽略，真实凭据不要提交。
# 注意：下面所有值都是占位符，请替换 —— 尤其不要把生产口令写进任何进版本库的文件。

# 监听地址。默认 127.0.0.1（只允许本机访问）；
# 需要局域网/公网访问（或跑在 Docker 里）时显式改成 0.0.0.0，启动时会打印告警。
HOST=127.0.0.1
PORT=3000

# 形如 postgresql://<用户>:<口令>@<主机>:<端口>/<库名>
# 口令含 / + = @ 等字符时需做 URL 编码
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_SSL=false
SEED_FILE=./data/options.json

# Docker Compose 使用的数据库配置；POSTGRES_PASSWORD 必须填写。
# compose 会用这三项生成容器内 DATABASE_URL，本地 npm start 仍使用上面的 DATABASE_URL。
POSTGRES_DB=huliaeat
POSTGRES_USER=huliaeat
POSTGRES_PASSWORD=

# 运行环境：production 下若未设置 ADMIN_TOKEN，服务会拒绝启动（fail-closed）
NODE_ENV=development

# 写接口（新增 / 编辑 / 删除 / 批量导入）的管理密钥。
# 生成一个：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 读接口（抽一次吃的）始终公开，不需要密钥。
ADMIN_TOKEN=

# 允许跨域调用写接口的来源，逗号分隔，例如 https://admin.example.com
# 留空表示只允许同域来源（推荐：前端和 API 同源部署时不用配）
CORS_ALLOWED_ORIGINS=

# 部署在 Nginx / 负载均衡之后时设为 true，用于取到真实客户端 IP（限流依赖它）
TRUST_PROXY=false

# ---- 高德开放平台（地图页，都是免费个人开发者 key，lbs.amap.com 注册）----
# 「Web端 (JS API)」类型的 key：前端画地图用，会随 GET /api/config 公开下发，
# 建议在高德控制台给它配域名白名单
AMAP_JSAPI_KEY=
# 上面的 JSAPI key 对应的安全密钥（控制台 key 右侧那串 jscode），一并下发给前端
AMAP_SECURITY_CODE=
# 「Web 服务」类型的 key：只给 npm run geocode 批量查坐标用，不下发前端
AMAP_WEB_KEY=
