PORT=3000
DATABASE_URL=postgresql://huliaeat:huliaeat@localhost:5432/huliaeat
DATABASE_SSL=false
SEED_FILE=./data/options.json

# 运行环境：production 下若未设置 ADMIN_TOKEN，服务会拒绝启动（fail-closed）
NODE_ENV=development

# 写接口（新增 / 编辑 / 删除 / 批量导入）的管理密钥。
# 生成一个：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 读接口（抽一次吃的）始终公开，不需要密钥。
ADMIN_TOKEN=

# 允许跨域调用写接口的来源，逗号分隔，例如 https://admin.example.com
# 留空表示只允许同域来源（推荐：前端和 API 同源部署时不用配）
CORS_ALLOWED_ORIGINS=

# 部署在 Nginx / 负载均衡之后时设为 true，用于取到真实客户端 IP（限流依赖它）
TRUST_PROXY=false
